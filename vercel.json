{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/grudge-game run build",
  "outputDirectory": "artifacts/grudge-game/dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/auth/:path*"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters/:path*"
    },
    {
      "source": "/api/characters",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/wallet/:path*"
    },
    {
      "source": "/api/inventory/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/inventory/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/health"
    },
    {
      "source": "/login",
      "destination": "https://id.grudge-studio.com/login"
    },
    {
      "source": "/api/gamedata/weapons",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/weapons.json"
    },
    {
      "source": "/api/gamedata/armor",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/armor.json"
    },
    {
      "source": "/api/gamedata/classes",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/classes.json"
    },
    {
      "source": "/api/gamedata/races",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/races.json"
    },
    {
      "source": "/api/gamedata/enemies",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/enemies.json"
    },
    {
      "source": "/api/gamedata/sprites",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/sprites2d.json"
    },
    {
      "source": "/api/gamedata/skillTrees",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/skillTrees.json"
    },
    {
      "source": "/api/gamedata/weaponSkills",
      "destination": "https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev/api/v1/weaponSkills.json"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
